# Copy this file to .env for a production deployment.

# Host directories and ports
KTV_SOURCE_MUSIC_DIR=./source-music
KTV_MUSIC_DIR=./music
KTV_HTTP_PORT=8080
KTV_DISCOVERY_UDP_PORT=18888
KTV_DISCOVERY_NAME=家庭KTV
TZ=Asia/Shanghai

# Database. Change the password before exposing the service to other users.
KTV_DB_NAME=ktv
KTV_DB_USER=ktv
KTV_DB_PASSWORD=change-me

# Image sources. Set a mirror when Docker Hub is unavailable.
KTV_IMAGE_REGISTRY=docker.m.daocloud.io
KTV_APP_IMAGE=home-ktv:latest

# Optional resource names, useful when running more than one instance.
KTV_APP_CONTAINER_NAME=ktv-app
KTV_DB_CONTAINER_NAME=ktv-db
KTV_DATA_VOLUME=home-ktv-data
KTV_PG_VOLUME=home-ktv-postgres

# Optional AI classification
KTV_AI_ENABLED=false
KTV_AI_BASE_URL=https://api.deepseek.com
KTV_AI_API_KEY=
KTV_AI_MODEL=deepseek-v4-flash
KTV_AI_AUTO_APPLY_CONFIDENCE=0.90

# JVM memory limit inside the application container
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -Xmx512m
