<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/recommendation_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtLanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLanAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:textColor="@color/dim"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLanConnect"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_gold"
        android:backgroundTint="@null"
        android:text="@string/setup_connect"
        android:textColor="@color/bg"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
